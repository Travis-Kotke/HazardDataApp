<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UWO_Safety_App.UserProblemSurvey"
             xmlns:local="clr-namespace:UWO_Safety_App"
             Title="UserProblemSurvey">
    <Grid RowDefinitions="Auto, *, *, Auto, *, Auto, Auto"
          Padding="10">
        <!-- Title of page -->
        <Label Grid.Row="0"
               Text="Details of problem"
               FontSize="24"
               Margin="0, 0, 0, 10"/>

        <HorizontalStackLayout Grid.Row="1"
                               VerticalOptions="Center">
            <Label Text="Severity: "
                   Margin="0, 0, 10, 0"
                   VerticalTextAlignment="Center"></Label>
            <Border Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 6"
                    Padding="0, 0">
                <Picker Title="Select a severity"
                        TitleColor="Black"
                        FontSize="14"
                        TextColor="Black"
                        SelectedIndex="-1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Low</x:String>
                            <x:String>Intermediate</x:String>
                            <x:String>High</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>
        </HorizontalStackLayout>


        <Grid ColumnDefinitions="Auto, *"
              ColumnSpacing="10"
              VerticalOptions="Center"
              Grid.Row="2">
            <Label Grid.Column="0"
                   Text="Description: "
                   Margin="0, 0, 10, 0"
                   VerticalTextAlignment="Start"></Label>
            <Label Grid.Column="1"
                   Text="The fire exit in Halsey by the main lecture halls is blocked by a stack of boxes"
                   LineBreakMode="WordWrap"></Label>

        </Grid>

        <HorizontalStackLayout
            VerticalOptions="Center"
            Grid.Row="3">
            <Label
                Text="Is it inside a building? "
                Margin="0, 0, 20, 0"
                VerticalTextAlignment="Center"></Label>
            <CheckBox></CheckBox>
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="Auto, *"
              RowDefinitions="Auto, Auto"
              ColumnSpacing="10"
              VerticalOptions="Center"
              Grid.Row="4"
              RowSpacing="15">
            <Label Grid.Column="0"
                   Grid.Row="0"
                   Text="Which Building? "
                   Margin="0, 0, 10, 0"
                   VerticalTextAlignment="Center"></Label>
            <Border Grid.Column="1"
                    Grid.Row="0"
                    Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 6"
                    Padding="0, 0">
                <Picker Title="Select a building"
                        TitleColor="Black"
                        FontSize="14"
                        TextColor="Black"
                        SelectedIndex="-1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Arts &amp; Communication Center</x:String>
                            <x:String>Clow Hall</x:String>
                            <x:String>Dempsey Hall</x:String>
                            <x:String>Halsey Science Center</x:String>
                            <x:String>Harrington Hall</x:String>
                            <x:String>Sage Hall</x:String>
                            <x:String>Swart Hall</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>
            <Label Grid.Column="0"
                   Grid.Row="1"
                   Text="Floor? "
                   Margin="0, 0, 10, 0"
                   VerticalTextAlignment="Center"></Label>
            <Border Grid.Column="1"
                    Grid.Row="1"
                    Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 6"
                    Padding="0, 0">
                <Picker Title="Select a floor"
                        TitleColor="Black"
                        FontSize="14"
                        TextColor="Black"
                        SelectedIndex="-1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>4</x:String>
                            <x:String>3</x:String>
                            <x:String>2</x:String>
                            <x:String>1</x:String>
                            <x:String>B</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>
        </Grid>
        <Button Text="Submit"
            Grid.Row="5"
            Margin="15, 30, 15, 80"></Button>

        <local:BottomNavBar Grid.Row="6" />
    </Grid>
</ContentPage>