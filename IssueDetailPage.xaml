<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UWO_Safety_App"
    x:Class="UWO_Safety_App.IssueDetailPage"
    x:DataType="local:Report"
    Title="Issue Details">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15" Spacing="12">

                <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" />
                <Label Text="{Binding StatusText}" FontSize="14" FontAttributes="Bold" />

                <Border Stroke="Black" StrokeThickness="1" Padding="10">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <Label Grid.Row="0" Text="Severity:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Severity}" />

                        <Label Grid.Row="1" Text="Location:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Location}" />

                        <Label Grid.Row="2" Text="Reported by:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReportedBy}" />

                        <Label Grid.Row="3" Text="Reported on:" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding DateReported, StringFormat='{0:MMM d, yyyy h:mm tt}'}" />
                    </Grid>
                </Border>

                <Label Text="Description" FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding Description}" FontSize="14" />

               
                <VerticalStackLayout x:Name="ResolutionSection" Spacing="6">
                    <Label Text="Resolution" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding DateResolved, StringFormat='Resolved on {0:MMM d, yyyy h:mm tt}'}" FontSize="14" />
                    <Label Text="{Binding ResolutionNotes}" FontSize="14" />
                </VerticalStackLayout>

               
                <VerticalStackLayout x:Name="ResolveSection" Spacing="6">
                    <Label Text="Resolution notes" FontSize="16" FontAttributes="Bold" />
                    <Editor x:Name="ResolutionNotesEditor"
                            Placeholder="What was done to fix this?"
                            HeightRequest="100" />
                    <Button Text="Mark as Resolved"
                            FontSize="16"
                            Clicked="MarkResolved_Clicked" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

     
        <local:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
