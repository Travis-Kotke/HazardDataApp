<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UWO_Safety_App"
    x:Class="UWO_Safety_App.LoginPage"
    Title="Login">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="15,12" BackgroundColor="White">
            <Label Text="Safety Hazard App" FontSize="16" FontAttributes="Bold" TextColor="#222222" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Log In" FontSize="11" Padding="12,5" HeightRequest="30" BackgroundColor="White" TextColor="#222222" BorderColor="#CCCCCC" BorderWidth="1" CornerRadius="4" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18" Spacing="16">

                <Border Stroke="#E5E5E5" StrokeThickness="1" Padding="16" BackgroundColor="White">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="Admin Login" FontSize="14" TextColor="#333333" />

                        <Label Text="Note: This is for Authorized UWO Personnel Only. Please contact the UWO Safety Department For Access" FontSize="13" TextColor="#333333" LineHeight="1.15" />

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Email:" FontSize="12" TextColor="#333333" />

                            <Entry Placeholder=" " Keyboard="Email" HeightRequest="38" FontSize="13" BackgroundColor="White" TextColor="#222222" PlaceholderColor="#999999" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Password:" FontSize="12" TextColor="#333333" />

                            <Entry Placeholder=" " IsPassword="True" HeightRequest="38" FontSize="13" BackgroundColor="White" TextColor="#222222" />
                        </VerticalStackLayout>

                        <Button Text="Forgot Password?" FontSize="10" Padding="10,4" HeightRequest="30" HorizontalOptions="Center" BackgroundColor="White" TextColor="#333333" BorderColor="#999999" BorderWidth="1" CornerRadius="5" />

                        <Button Text="Sign In" FontSize="12" HeightRequest="38"  BackgroundColor="#3483FA" TextColor="White" CornerRadius="5" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Shared bottom navigation -->
        <local:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>
