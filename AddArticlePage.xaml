<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:UWO_Safety_App"
             x:Class="UWO_Safety_App.AddArticlePage"
             Title="Add Article">
    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="15,12" BackgroundColor="White">

            <Label Text="Safety Hazard App" FontSize="16" FontAttributes="Bold" TextColor="#222222"  VerticalOptions="Center" />

            <Button Grid.Column="1" Text="Log Out" FontSize="11" Padding="12,5" HeightRequest="30"  BackgroundColor="White" TextColor="#222222" BorderColor="#CCCCCC" BorderWidth="1" CornerRadius="4" />
        </Grid>

        <!-- Add article form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,15" Spacing="12">

                <Border Stroke="#E5E5E5" StrokeThickness="1" Padding="15" BackgroundColor="White">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Add Article" FontSize="14" FontAttributes="Bold" TextColor="#333333" HorizontalTextAlignment="Center" />

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Article Title" FontSize="12" TextColor="#333333" />

                            <Entry Placeholder=" " FontSize="13" HeightRequest="38" BackgroundColor="White" TextColor="#222222" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Article Text" FontSize="12" TextColor="#333333" />

                            <Editor Placeholder=" " FontSize="13" HeightRequest="190" AutoSize="Disabled" BackgroundColor="White" TextColor="#222222" />
                        </VerticalStackLayout>

                        <Button Text="Submit" FontSize="12" HeightRequest="40" BackgroundColor="#3483FA" TextColor="White" CornerRadius="5" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Shared bottom navigation -->
        <local:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>
