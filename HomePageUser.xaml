<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UWO_Safety_App"
    x:Class="UWO_Safety_App.HomePageUser"
    Title="Home Page">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row ="0" ColumnDefinitions="*,Auto" Padding="15">
            <Label Text="Safety Reporting @ UWO" FontSize="20" FontAttributes="Bold" />
            <Button Text="Log In" Grid.Column="1" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="10">
            <Label Text="Welcome to the UWO Safety Reporting App!" FontSize="18" HorizontalTextAlignment="Center" />
            <Label Text="Use the navigation bar to access different features of the app." FontSize="14" HorizontalTextAlignment="Center" />
            <Image Source="campus_map.png" Aspect="AspectFit" />
        </VerticalStackLayout>
       <!-- Shared navigation bar, All Pages should have this -->
        <local:BottomNavBar Grid.Row="2" />
    </Grid>
</ContentPage>