<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UWO_Safety_App.CameraScreen"
             Title="CameraScreen">

    <Grid RowDefinitions="Auto, *, Auto">
    <VerticalStackLayout Grid.Row="0">
        <Label 
            Text="Please take a picture of the problem."
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
    <Border Grid.Row="1"
            Margin="10, 20, 10, 20"
            Stroke="Black"
            StrokeThickness="2">
    <Image Source="dumpster_fire.webp"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />
    </Border>
    

        <Button Grid.Row="2"
                Text="+"
                FontSize="30"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="#3483FA"
                TextColor="White"
                />
    </Grid>
</ContentPage>