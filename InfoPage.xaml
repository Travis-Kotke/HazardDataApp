<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UWO_Safety_App"
    x:Class="UWO_Safety_App.InfoPage"
    Title="Info Page">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="10">

        <Label Grid.Row="0"
               Text="Info Page"
               FontSize="20"
               Margin="0,10,0,25" />

        <!-- Hazard categories Note: placeholder data -->
        <Border Grid.Row="1"
                Stroke="Black"
                StrokeThickness="1">

            <VerticalStackLayout Spacing="0">

                <Button Text="Fire Hazards"
                        FontSize="30"
                        TextColor="Black"
                        BackgroundColor="White"
                        HorizontalOptions="Fill" />

                <BoxView HeightRequest="1"
                         Color="Black" />

                <Button Text="Winter Dangers"
                        FontSize="30"
                        TextColor="Black"
                        BackgroundColor="White"
                        HorizontalOptions="Fill" />

                <BoxView HeightRequest="1"
                         Color="Black" />

                <Button Text="Common Mistakes"
                        FontSize="30"
                        TextColor="Black"
                        BackgroundColor="White"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </Border>

        <!-- Shared navigation bar -->
        <local:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>
