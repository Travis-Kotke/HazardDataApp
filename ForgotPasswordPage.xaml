<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UWO_Safety_App"
    x:Class="UWO_Safety_App.ForgotPasswordPage"
    Title="Forgot Password">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="15,12" BackgroundColor="White">

            <Label Text="Safety Hazard App" FontSize="16" FontAttributes="Bold" TextColor="#222222" VerticalOptions="Center" />

            <Button Grid.Column="1" Text="Log In" FontSize="11" Padding="12,5" HeightRequest="30" BackgroundColor="White" TextColor="#222222" BorderColor="#CCCCCC" BorderWidth="1" CornerRadius="4" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="20,18">

            <Border Stroke="#E5E5E5" StrokeThickness="1" BackgroundColor="White" Padding="15" VerticalOptions="Fill">

                <Grid RowDefinitions="Auto,*,Auto" Padding="0">

                    <Label Grid.Row="0" Text="Forgot Password" FontSize="13" FontAttributes="Bold" TextColor="#333333" HorizontalTextAlignment="Center" Padding="0,8,0,12" />

                    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="10">

                        <Label Text="Check your email for password reset instructions." FontSize="13" TextColor="#333333" HorizontalTextAlignment="Start" HorizontalOptions="Fill" LineHeight="1.15" />

                        <Button Text="Sign In" FontSize="12" WidthRequest="105" HeightRequest="38" HorizontalOptions="Center" BackgroundColor="#3483FA" TextColor="White" CornerRadius="5" />

                    </VerticalStackLayout>

                </Grid>
            </Border>

        </VerticalStackLayout>

        <!-- Shared bottom navigation -->
        <local:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>
