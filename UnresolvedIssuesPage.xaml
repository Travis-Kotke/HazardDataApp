<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UWO_Safety_App"
    x:Class="UWO_Safety_App.UnresolvedIssuesPage"
    Title="Unresolved Issues">

    <Grid RowDefinitions="Auto,*,Auto">
        <Label Grid.Row="0"
               Text="Unresolved Issues"
               FontSize="20"
               FontAttributes="Bold"
               Padding="15" />

        <!-- Tap an issue to open the advanced view -->
        <CollectionView x:Name="IssuesList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="IssuesList_SelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="No unresolved issues."
                       HorizontalTextAlignment="Center"
                       Margin="0,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Report">
                    <Border Stroke="Black"
                            StrokeThickness="1"
                            Margin="15,5"
                            Padding="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Location}" FontSize="14" />
                            <Label Text="{Binding DateReported, StringFormat='Reported {0:MMM d, h:mm tt}'}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        
        <local:BottomNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
