<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HazardDataApp.UI.Views"
             x:Class="HazardDataApp.UI.Views.HomePage" Title="Hazards Data App">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12" BackgroundColor="White">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" x:Name="RefreshButton" Text="Refresh" Clicked="OnRefreshClicked"
                    BackgroundColor="#512BD4" TextColor="White" BorderColor="#512BD4" BorderWidth="1"
                    CornerRadius="8" Padding="16,8" HeightRequest="44" FontSize="14" />
            <Button Grid.Column="2" x:Name="ExportButton" Text="Export" Clicked="OnExportClicked"
                    BackgroundColor="#EEEAFB" TextColor="#512BD4" BorderColor="#DDD3F8" BorderWidth="1"
                    CornerRadius="8" Padding="16,8" HeightRequest="44" FontSize="14" />
        </Grid>
        <Label Grid.Row="1" x:Name="StatusLabel" Text="Load reports to get started." TextColor="#555560" />
        <Grid Grid.Row="2" x:Name="BodyGrid" RowDefinitions="Auto,*" ColumnSpacing="20" RowSpacing="12" SizeChanged="OnBodySizeChanged">
            <Border x:Name="FiltersPanel" Padding="20" Stroke="#DADAE2" StrokeShape="RoundRectangle 12">
                <Border.Resources>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="#34343E" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                    <Style x:Key="FilterField" TargetType="Border">
                        <Setter Property="Stroke" Value="#E2E2EA" />
                        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                        <Setter Property="BackgroundColor" Value="#F7F7FA" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                    <Style TargetType="Picker">
                        <Setter Property="TextColor" Value="#24242B" />
                        <Setter Property="TitleColor" Value="#777780" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="HeightRequest" Value="44" />
                        <Setter Property="MinimumWidthRequest" Value="0" />
                        <Setter Property="BackgroundColor" Value="Transparent" />
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Color" Value="#512BD4" />
                        <Setter Property="WidthRequest" Value="24" />
                        <Setter Property="HeightRequest" Value="24" />
                        <Setter Property="MinimumWidthRequest" Value="24" />
                        <Setter Property="MinimumHeightRequest" Value="24" />
                        <Setter Property="HorizontalOptions" Value="Start" />
                        <Setter Property="VerticalOptions" Value="Center" />
                    </Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="TextColor" Value="#24242B" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="HeightRequest" Value="44" />
                        <Setter Property="MinimumWidthRequest" Value="0" />
                        <Setter Property="BackgroundColor" Value="Transparent" />
                    </Style>
                </Border.Resources>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                    <Label Text="Filters" FontSize="24" FontAttributes="Bold" />
                    <ScrollView Grid.Row="1" x:Name="FiltersScroll" HeightRequest="260">
                        <VerticalStackLayout Spacing="18">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Incident title" FontAttributes="Bold" />
                                <Border Style="{StaticResource FilterField}">
                                    <Entry x:Name="TitleEntry" Placeholder="Search incident title" TextChanged="OnFilterChanged"
                                           TextColor="#24242B" PlaceholderColor="#777780" BackgroundColor="Transparent"
                                           FontSize="14" HeightRequest="44" MinimumWidthRequest="0" ClearButtonVisibility="WhileEditing" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="44">
                                    <Label Text="Filter by date range" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" x:Name="UseDateRange" Toggled="OnDateRangeChanged"
                                            OnColor="#512BD4" HorizontalOptions="End" VerticalOptions="Center"
                                            SemanticProperties.Description="Filter by date range" />
                                </Grid>
                                <Grid x:Name="DatesGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="40,*" RowSpacing="8" ColumnSpacing="8" IsVisible="False" IsEnabled="False">
                                    <Label Text="From" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource FilterField}">
                                        <DatePicker x:Name="FromDatePicker" Format="MMM d, yyyy" DateSelected="OnFilterChanged" />
                                    </Border>
                                    <Label Grid.Row="1" Text="To" VerticalOptions="Center" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FilterField}">
                                        <DatePicker x:Name="ToDatePicker" Format="MMM d, yyyy" DateSelected="OnFilterChanged" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Type" FontAttributes="Bold" />
                                <Border Style="{StaticResource FilterField}">
                                    <Picker Title="Types pending" IsEnabled="False" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Severity" FontAttributes="Bold" />
                                <Border Style="{StaticResource FilterField}">
                                    <Picker x:Name="SeverityPicker" SelectedIndexChanged="OnFilterChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Resolution status" FontAttributes="Bold" />
                                <Border Style="{StaticResource FilterField}">
                                    <Picker x:Name="ResolutionPicker" SelectedIndexChanged="OnFilterChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="44">
                                <Label Text="Public reports only" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="PublishedSwitch" Toggled="OnFilterChanged"
                                        OnColor="#512BD4" HorizontalOptions="End" VerticalOptions="Center"
                                        SemanticProperties.Description="Show public reports only" />
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Grid.Row="2" Text="Clear filters" Clicked="OnClearFiltersClicked"
                            BackgroundColor="#EEEAFB" TextColor="#512BD4" CornerRadius="8" HeightRequest="44" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" x:Name="ReportsPanel" RowDefinitions="Auto,*" RowSpacing="8">
                <Label x:Name="ResultsLabel" Text="Hazard reports" FontSize="18" TextColor="#24242B" />
                <Border Grid.Row="1" Stroke="#DADAE2" StrokeShape="RoundRectangle 10">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="TableGrid" WidthRequest="680" RowDefinitions="Auto,*">
                            <Grid Padding="14,12" ColumnDefinitions="*,100,70,170" ColumnSpacing="8" BackgroundColor="#EEEEF3">
                                <Label Text="Incident" FontAttributes="Bold" TextColor="#24242B" />
                                <Label Grid.Column="1" Text="Severity" FontAttributes="Bold" TextColor="#24242B" />
                                <Label Grid.Column="2" Text="Public?" FontAttributes="Bold" TextColor="#24242B" />
                                <Label Grid.Column="3" Text="Actions" FontAttributes="Bold" TextColor="#24242B" />
                            </Grid>
                            <CollectionView Grid.Row="1" x:Name="ReportsList" SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <Label x:Name="EmptyLabel" Text="No reports loaded." Padding="24" TextColor="#555560" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="views:ReportRow">
                                        <Grid Padding="14" ColumnDefinitions="*,100,70,170" ColumnSpacing="8" BackgroundColor="{Binding Background}">
                                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Report.Title}" FontAttributes="Bold" TextColor="#24242B" MaxLines="2" />
                                                <Label Text="{Binding Report.Location}" FontSize="12" TextColor="#666670" />
                                                <Label Text="{Binding Report.DateReported, StringFormat='{0:MMM d, yyyy}'}" FontSize="12" TextColor="#666670" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Report.Severity}" TextColor="{Binding SeverityColor}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding PublicLabel}" TextColor="#24242B" VerticalOptions="Center" />
                                            <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                                <!-- Enable once the is_flagged migration has been applied and verified. -->
                                                <ImageButton Source="report_flag.png" Clicked="OnFlagClicked" IsEnabled="False"
                                                             WidthRequest="{OnPlatform Default=44, WinUI=36}" HeightRequest="{OnPlatform Default=44, WinUI=36}"
                                                             MinimumWidthRequest="0" MinimumHeightRequest="0" Padding="8"
                                                             CornerRadius="6" BackgroundColor="{Binding FlagColor}"
                                                             VerticalOptions="Center" HorizontalOptions="Start"
                                                             ToolTipProperties.Text="{Binding FlagLabel}"
                                                             SemanticProperties.Description="{Binding FlagLabel}" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                    <Label Text="{Binding StatusLabel}" FontSize="13" FontAttributes="Bold" TextColor="#34343E" />
                                                    <Button Text="{Binding ResolutionAction}" IsEnabled="False" FontSize="12" Padding="8,2"
                                                            HeightRequest="32" MinimumHeightRequest="0" MinimumWidthRequest="0"
                                                            BackgroundColor="#EEEAFB" TextColor="#512BD4" CornerRadius="6" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
