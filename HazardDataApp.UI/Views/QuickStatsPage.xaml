<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HazardDataApp.UI.Views.QuickStatsPage" Title="Quick Stats">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Report statistics" FontSize="24" />
        <Label x:Name="StatusLabel" Text="Open this tab to load reports." />
        <Label x:Name="TotalLabel" Text="Total: —" />
        <Label x:Name="OpenLabel" Text="Open: —" />
        <Label x:Name="ResolvedLabel" Text="Resolved: —" />
        <Button x:Name="RefreshButton" Text="Refresh" Clicked="OnRefreshClicked" />
    </VerticalStackLayout>
</ContentPage>
