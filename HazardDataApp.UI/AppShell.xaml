<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="HazardDataApp.UI.AppShell" FlyoutBehavior="Disabled">
    <!-- Shell starts with the first declared item, Home. Routes are registered here. -->
    <TabBar Route="main">
        <ShellContent x:Name="HomeContent" Title="Home" Route="home" />
        <ShellContent x:Name="ArticleContent" Title="Add Article" Route="add-article" />
        <ShellContent x:Name="StatsContent" Title="Quick Stats" Route="quick-stats" />
    </TabBar>
</Shell>
