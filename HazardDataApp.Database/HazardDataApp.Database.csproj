<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supabase" Version="8.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <!-- Use shared public defaults unless an ignored local override exists. -->
    <Compile Remove="SupabaseConfig.example.cs" />
    <Compile Remove="SupabaseConfig.defaults.cs" Condition="Exists('SupabaseConfig.cs')" />
  </ItemGroup>
</Project>
