<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UWO_Safety_App.ArticlePage"
             xmlns:local="clr-namespace:UWO_Safety_App"
             Title="ArticlePage">
    <Grid RowDefinitions="Auto, *,Auto"
          Padding="10">
        <Label Grid.Row="0"
            Text="Winter Dangers"
            FontSize="24"
            Margin="0, 0, 0, 10"
             />
        <Label Grid.Row="1"
            Text="During the winter months, there are several safety hazards to watch out for. Snow and ice can create slippery sidewalks, parking lots, and stairways, increasing the risk of slips and falls. Cold temperatures can also lead to frostbite or hypothermia if proper winter clothing is not worn. Additionally, snow buildup can block emergency exits and create dangerous conditions. To stay safe, always wear appropriate footwear, use caution when walking on icy surfaces, dress warmly, and report any hazardous conditions that need attention."
            LineBreakMode="WordWrap"
            FontSize="12"></Label>
    <!-- Shared navigation bar -->
        <local:BottomNavBar Grid.Row="2" />
    </Grid>
</ContentPage>